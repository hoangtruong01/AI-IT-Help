# =============================================================================
# EOMP — Enterprise Operations Management Platform (.env.example)
# =============================================================================
# Copy this file to .env and customize for your local or production environment.
# NEVER commit your actual .env file to version control.
# Reference dashboard URLs: docs/QUICKSTART_URLS.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Global Application & Security Environment
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# Mandatory JWT Secret Key (HMAC-SHA256) - Min 32 characters
# Generate with: openssl rand -base64 48
JWT_SECRET=
AUDIT_HMAC_KEY=
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# Trusted Proxy IP List for Anti-Spoofing (comma separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Optional one-time initial administrator bootstrap. Leave both empty normally.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Initial Administrator

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database Infrastructure (PostgreSQL 17)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eomp
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=eomp
POSTGRES_SSLMODE=disable

# Dedicated Microservice Databases
AUTH_DB_NAME=auth_db
EMPLOYEE_DB_NAME=employee_db
ASSET_DB_NAME=asset_db
HELPDESK_DB_NAME=helpdesk_db
WORKFLOW_DB_NAME=workflow_db
NOTIFICATION_DB_NAME=notification_db
KNOWLEDGE_DB_NAME=knowledge_db
AUDIT_DB_NAME=audit_db
REPORTING_DB_NAME=reporting_db

# -----------------------------------------------------------------------------
# 3. Redis Caching & Rate Limiting (Redis 7)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# 4. RabbitMQ Message Broker (RabbitMQ 4 AMQP)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=eomp
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_PORT=15672
# Optional full URL override. Component variables above are URL-escaped by code.
RABBITMQ_URL=

# -----------------------------------------------------------------------------
# 5. MinIO Object Storage (S3 Compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=eomp_minio
# Generate with: openssl rand -base64 24
MINIO_SECRET_KEY=

# -----------------------------------------------------------------------------
# 6. Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=knowledge_base
QDRANT_URL=http://localhost:6333

# -----------------------------------------------------------------------------
# 7. AI Operations Copilot Configuration
# -----------------------------------------------------------------------------
AI_PROVIDER=mock
ALLOW_MOCK_AI=false
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 8. Observability & Monitoring (Prometheus, Grafana, Loki)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
LOKI_PORT=3100

# -----------------------------------------------------------------------------
# 9. Gateway Internal Routing URLs
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8081
EMPLOYEE_SERVICE_URL=http://localhost:8082
ASSET_SERVICE_URL=http://localhost:8083
HELPDESK_SERVICE_URL=http://localhost:8084
WORKFLOW_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
KNOWLEDGE_SERVICE_URL=http://localhost:8087
AI_SERVICE_URL=http://localhost:8088
AUDIT_SERVICE_URL=http://localhost:8089
REPORTING_SERVICE_URL=http://localhost:8090

# -----------------------------------------------------------------------------
# 10. Frontend Configuration (Nuxt 4)
# -----------------------------------------------------------------------------
NUXT_PORT=3000
NUXT_PUBLIC_API_URL=http://localhost:8080
