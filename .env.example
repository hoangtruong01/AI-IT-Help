# ==============================
# EOMP — Environment Configuration
# ==============================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ==============================
# Application
# ==============================
APP_ENV=development
APP_PORT=8080

# ==============================
# PostgreSQL
# ==============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eomp
POSTGRES_PASSWORD=
POSTGRES_DB=eomp

# ==============================
# Redis
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================
# RabbitMQ
# ==============================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=eomp
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================
# MinIO
# ==============================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_CONSOLE_PORT=9001

# ==============================
# Qdrant
# ==============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ==============================
# AI
# ==============================
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=

# ==============================
# Monitoring
# ==============================
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# ==============================
# Frontend
# ==============================
NUXT_PORT=3000
NUXT_PUBLIC_API_URL=http://localhost:8080
