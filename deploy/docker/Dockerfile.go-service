# ==============================================================================
# EOMP — Universal Multi-Stage Dockerfile for Go Microservices (Pinned & Hardened)
# ==============================================================================
# Usage:
#   docker build \
#     --build-arg SERVICE_NAME=auth \
#     --build-arg PORT=8081 \
#     -t eomp/auth:latest \
#     -f deploy/docker/Dockerfile.go-service .
# ==============================================================================

# --- Stage 1: Build & Compile Binary ---
FROM golang:1.25.0-alpine3.21 AS builder

ARG SERVICE_NAME
ARG PORT=8080

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /workspace

# Copy workspace definition and dependencies
# go.work.sum is optional and is not committed in this repository. Module
# checksums are resolved from the copied module manifests during the build.
COPY go.work ./
COPY packages/shared packages/shared
COPY services services

# Build static binary without CGO, strip symbols to achieve < 20MB binary size
WORKDIR /workspace/services/${SERVICE_NAME}
RUN GOWORK=off CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w -extldflags '-static'" -o /app/server ./cmd/server \
    && mkdir -p /app/migrations \
    && if [ -d migrations ]; then cp -R migrations/. /app/migrations/; fi

# --- Stage 2: Final Minimal Runtime Image (< 25MB, CIS Hardened Non-Root) ---
FROM alpine:3.21.3 AS runner

ARG SERVICE_NAME
ARG PORT=8080

# Install SSL certificates & Timezone support
RUN apk --no-cache add ca-certificates tzdata wget \
    && addgroup -g 10001 -S appgroup \
    && adduser -u 10001 -S appuser -G appgroup

WORKDIR /app

# Copy binary from builder
COPY --from=builder --chown=appuser:appgroup /app/server /app/server

# Copy SQL migrations if present
COPY --from=builder --chown=appuser:appgroup /app/migrations /app/migrations

# Set security context and environment
USER 10001:10001
ENV APP_ENV=production \
    PORT=${PORT} \
    TZ=UTC

EXPOSE ${PORT}

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:${PORT}/health || exit 1

ENTRYPOINT ["/app/server"]
