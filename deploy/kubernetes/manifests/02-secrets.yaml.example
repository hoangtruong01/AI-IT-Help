# Copy this file outside source control, replace every placeholder, then apply it.
# Prefer an external secrets operator or your cloud secret manager in production.
apiVersion: v1
kind: Secret
metadata:
  name: eomp-secrets
  namespace: eomp
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME"
  # Per-Service Database Isolation Credentials (Least Privilege)
  AUTH_DB_USER: "auth_svc"
  AUTH_DB_PASSWORD: "REPLACE_AUTH_DB_PASSWORD"
  EMPLOYEE_DB_USER: "employee_svc"
  EMPLOYEE_DB_PASSWORD: "REPLACE_EMPLOYEE_DB_PASSWORD"
  ASSET_DB_USER: "asset_svc"
  ASSET_DB_PASSWORD: "REPLACE_ASSET_DB_PASSWORD"
  HELPDESK_DB_USER: "helpdesk_svc"
  HELPDESK_DB_PASSWORD: "REPLACE_HELPDESK_DB_PASSWORD"
  WORKFLOW_DB_USER: "workflow_svc"
  WORKFLOW_DB_PASSWORD: "REPLACE_WORKFLOW_DB_PASSWORD"
  KNOWLEDGE_DB_USER: "knowledge_svc"
  KNOWLEDGE_DB_PASSWORD: "REPLACE_KNOWLEDGE_DB_PASSWORD"
  NOTIFICATION_DB_USER: "notification_svc"
  NOTIFICATION_DB_PASSWORD: "REPLACE_NOTIFICATION_DB_PASSWORD"
  AUDIT_DB_USER: "audit_svc"
  AUDIT_DB_PASSWORD: "REPLACE_AUDIT_DB_PASSWORD"
  REPORTING_DB_USER: "reporting_svc"
  REPORTING_DB_PASSWORD: "REPLACE_REPORTING_DB_PASSWORD"
  JWT_SECRET: "REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
  AUDIT_HMAC_KEY: "REPLACE_WITH_A_DIFFERENT_32_PLUS_CHARACTER_RANDOM_KEY"
  OPENAI_API_KEY: "REPLACE_WITH_PROVIDER_API_KEY"
  GEMINI_API_KEY: "REPLACE_ONLY_IF_USING_GEMINI"
  RABBITMQ_USER: "REPLACE_ME"
  RABBITMQ_PASSWORD: "REPLACE_ME"
  MINIO_ACCESS_KEY: "REPLACE_ME"
  MINIO_SECRET_KEY: "REPLACE_ME"
  GRAFANA_ADMIN_USER: "REPLACE_ME"
  GRAFANA_ADMIN_PASSWORD: "REPLACE_ME"
