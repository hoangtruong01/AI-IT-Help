apiVersion: v1
kind: Secret
metadata:
  name: eomp-secrets
  namespace: eomp
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME"
  JWT_SECRET: "REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
  RABBITMQ_USER: "REPLACE_ME"
  RABBITMQ_PASSWORD: "REPLACE_ME"
  MINIO_ACCESS_KEY: "REPLACE_ME"
  MINIO_SECRET_KEY: "REPLACE_ME"
  GRAFANA_ADMIN_USER: "REPLACE_ME"
  GRAFANA_ADMIN_PASSWORD: "REPLACE_ME"
